generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  // Single-device login: the one device currently allowed to hold a session.
  // Overwritten on each fresh login; admin can clear it to free up a login slot.
  activeDeviceId String?

  enrollments Enrollment[]
  payments    Payment[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  priceInPaise Int
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]
  payments    Payment[]
}

model Lesson {
  id         String  @id @default(cuid())
  courseId   String
  title      String
  order      Int
  videoId    String // reference to the video on the streaming provider (e.g. Bunny Stream video GUID)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  courseId          String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  amountInPaise     Int
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}
